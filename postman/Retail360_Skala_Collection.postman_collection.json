		{
			"name": "CA-01: Consultar Producto Existente (LAP-001)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Product details are correct\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.sku).to.eql(\"LAP-001\");",
							"    pm.expect(jsonData.productName).to.eql(\"Laptop 14 pulgadas\");",
							"    pm.expect(jsonData.unitPrice).to.eql(18000);",
							"    pm.expect(jsonData.active).to.eql(true);",
							"    pm.expect(jsonData.stock).to.be.at.least(1);",
							"});",
							"pm.test(\"X-Correlation-ID header present\", function () {",
							"    pm.response.to.have.header(\"X-Correlation-ID\");",
							"});"
						],
						"type": "text/javascript"
					}
