<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd ">
    <http:listener-config name="retail-salesforce-sys-api-httpListenerConfig">
        <http:listener-connection host="0.0.0.0" port="${api.http.port}" />
    </http:listener-config>
    <apikit:config name="retail-salesforce-sys-api-config" api="resource::876dba8c-1a93-41e2-ba53-3af65c408406:retail-salesforce-sys-api:1.0.0:raml:zip:retail-salesforce-sys-api.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />

    <!-- Listener Principal (/api/v1/* según baseUri RAML) -->
    <flow name="retail-salesforce-sys-api-main">
        <http:listener config-ref="retail-salesforce-sys-api-httpListenerConfig" path="/api/v1/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <flow-ref doc:name="retail-salesforce-sys-api-routerSub_Flow" name="retail-salesforce-sys-api-routerSub_Flow" />
    </flow>

    <!-- Listener Alias (/api/* para retrocompatibilidad) -->
    <flow name="retail-salesforce-sys-api-main-legacy">
        <http:listener config-ref="retail-salesforce-sys-api-httpListenerConfig" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <flow-ref doc:name="retail-salesforce-sys-api-routerSub_Flow" name="retail-salesforce-sys-api-routerSub_Flow" />
    </flow>

    <sub-flow name="retail-salesforce-sys-api-routerSub_Flow">
        <ee:transform doc:name="Init CorrelationId">
            <ee:variables>
                <ee:set-variable variableName="correlationId"><![CDATA[attributes.headers.'x-correlation-id' default correlationId]]></ee:set-variable>
                <ee:set-variable variableName="outboundHeaders"><![CDATA[output application/java
---
{
    "X-Correlation-ID": attributes.headers.'x-correlation-id' default correlationId
}]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <try doc:name="Try APIKit Router">
            <apikit:router config-ref="retail-salesforce-sys-api-config" />
            <error-handler>
                <on-error-continue type="APIKIT:BAD_REQUEST">
                    <ee:transform doc:name="400 VALIDATION_ERROR">
                        <ee:message>
                            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  success: false,
  error: {
    code: "VALIDATION_ERROR",
    message: error.description default "La solicitud contiene datos invalidos.",
    httpStatus: 400,
    correlationId: vars.correlationId default correlationId
  }
}]]></ee:set-payload>
                        </ee:message>
                        <ee:variables>
                            <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                        </ee:variables>
                    </ee:transform>
                </on-error-continue>
                <on-error-continue type="APP:SALESFORCE_REJECTED">
                    <ee:transform doc:name="502 SALESFORCE_REJECTED">
                        <ee:message>
                            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  success: false,
  error: {
    code: "SALESFORCE_REJECTED",
    message: error.description default "Salesforce rechazo uno o mas registros.",
    httpStatus: 502,
    correlationId: vars.correlationId default correlationId
  }
}]]></ee:set-payload>
                        </ee:message>
                        <ee:variables>
                            <ee:set-variable variableName="httpStatus">502</ee:set-variable>
                        </ee:variables>
                    </ee:transform>
                </on-error-continue>
                <on-error-continue type="SALESFORCE:CONNECTIVITY">
                    <ee:transform doc:name="503 DEPENDENCY_UNAVAILABLE">
                        <ee:message>
                            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  success: false,
  error: {
    code: "DEPENDENCY_UNAVAILABLE",
    message: "No fue posible establecer conexion con Salesforce CRM.",
    httpStatus: 503,
    correlationId: vars.correlationId default correlationId
  }
}]]></ee:set-payload>
                        </ee:message>
                        <ee:variables>
                            <ee:set-variable variableName="httpStatus">503</ee:set-variable>
                        </ee:variables>
                    </ee:transform>
                </on-error-continue>
                <on-error-continue type="APIKIT:NOT_FOUND">
                    <ee:transform doc:name="404 RESOURCE_NOT_FOUND">
                        <ee:message>
                            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  success: false,
  error: {
    code: "RESOURCE_NOT_FOUND",
    message: "El recurso solicitado no existe.",
    httpStatus: 404,
    correlationId: vars.correlationId default correlationId
  }
}]]></ee:set-payload>
                        </ee:message>
                        <ee:variables>
                            <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                        </ee:variables>
                    </ee:transform>
                </on-error-continue>
                <on-error-continue type="ANY">
                    <ee:transform doc:name="500 INTERNAL_ERROR">
                        <ee:message>
                            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  success: false,
  error: {
    code: "INTERNAL_ERROR",
    message: error.description default "Ocurrio un error inesperado en Salesforce System API.",
    httpStatus: 500,
    correlationId: vars.correlationId default correlationId
  }
}]]></ee:set-payload>
                        </ee:message>
                        <ee:variables>
                            <ee:set-variable variableName="httpStatus">500</ee:set-variable>
                        </ee:variables>
                    </ee:transform>
                </on-error-continue>
            </error-handler>
        </try>
    </sub-flow>

    <flow name="retail-salesforce-sys-api-console">
        <http:listener config-ref="retail-salesforce-sys-api-httpListenerConfig" path="/console/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="retail-salesforce-sys-api-config" />
    </flow>

    <flow name="put:\orders\(orderId):application\json:retail-salesforce-sys-api-config">
        <ee:transform doc:name="Extract orderId">
            <ee:variables>
                <ee:set-variable variableName="orderId">attributes.uriParams.'orderId'</ee:set-variable>
            </ee:variables>
        </ee:transform>
        <logger level="INFO" doc:name="Logger Inicio" message="[#[vars.correlationId]] Iniciando sincronizacion hacia Salesforce para orden: #[vars.orderId]" />
        <flow-ref doc:name="imp-put-order-salesforceSub_Flow" name="imp-put-order-salesforceSub_Flow"/>
        <logger level="INFO" doc:name="Logger Fin" message="[#[vars.correlationId]] Orden #[vars.orderId] sincronizada exitosamente en Salesforce con ID: #[payload.salesforceId]" />
    </flow>

    <flow name="get:\orders\(orderId):retail-salesforce-sys-api-config">
        <ee:transform doc:name="Extract orderId">
            <ee:variables>
                <ee:set-variable variableName="orderId">attributes.uriParams.'orderId'</ee:set-variable>
            </ee:variables>
        </ee:transform>
        <logger level="INFO" doc:name="Logger Inicio" message="[#[vars.correlationId]] Consultando orden en Salesforce: #[vars.orderId]" />
        <flow-ref doc:name="imp-get-order-salesforceSub_Flow" name="imp-get-order-salesforceSub_Flow"/>
        <logger level="INFO" doc:name="Logger Fin" message="[#[vars.correlationId]] Orden obtenida exitosamente desde Salesforce: #[vars.orderId]" />
    </flow>
</mule>
